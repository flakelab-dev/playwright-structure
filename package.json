{
  "name": "playwright-structure",
  "version": "1.0.0",
  "private": true,
  "description": "A Playwright + TypeScript project structure that scales. Companion repo for flakelab.dev.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:repeat": "playwright test --repeat-each=20",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
